{"case_id": "B12", "status_ok": true, "metric_ok": true, "dimension_ok": true, "region_ok": false, "numeric_ok": false, "sql_verified": true, "reward": 2.0, "passed": false, "repeat_index": 3, "question": "2026-01-01 到 2026-12-31 华东地区各营销活动带来的批准退款金额贡献是多少？", "result": {"run_id": "9b2dcd5c-6f8f-4dbe-a2f3-dea97eb4e1b9", "status": "answered", "metric": {"id": "approved_refund_campaign_attribution", "name": "批准退款金额多触点活动归因", "formula": "订单批准退款金额按有效 campaign touch 权重分摊；缺失 attribution 单独列示", "time_basis": "下单时间（UTC）", "refund_status": "仅 approved", "definition_version": "1.0.0", "effective_from": "2026-10-01", "grain": "订单 × campaign attribution", "definition_source": "docs/product-contract.md#多触点活动归因", "lineage": ["orders.order_id", "refunds.amount_cents", "refunds.status", "campaign_attributions.weight", "campaigns.campaign_name"]}, "plan": {"start_date_inclusive": "2026-01-01", "end_date_exclusive": "2027-01-01", "periods": [["2026-01-01", "2027-01-01"]], "region": "华东地区", "dimension": "campaign"}, "data_version": "insightpilot-enterprise-v1", "data_fingerprint": "c2d4e473ae87a03f0c252c464b1d1fac393b7da58fbc982935708137d622aa92", "generated_at_utc": "2026-10-20T03:02:10.459696+00:00", "sql": "WITH eligible_orders AS (\n    SELECT o.order_id\n    FROM orders o WHERE o.status = 'paid' AND o.ordered_at >= ? AND o.ordered_at < ? AND o.region = ?\n), approved_refunds AS (\n    SELECT order_id, SUM(amount_cents) AS refund_cents\n    FROM refunds WHERE status='approved' GROUP BY order_id\n), base AS (\n    SELECT e.order_id, COALESCE(r.refund_cents,0) AS refund_cents\n    FROM eligible_orders e LEFT JOIN approved_refunds r ON r.order_id=e.order_id\n), attributed_refunds AS (\n    SELECT b.order_id, b.refund_cents,\n           CASE WHEN a.campaign_id IS NULL THEN '未归因' ELSE c.campaign_name END AS group_value,\n           CASE WHEN a.campaign_id IS NULL THEN 1.0 ELSE a.weight END AS attribution_weight\n    FROM base b\n    LEFT JOIN campaign_attributions a ON a.order_id=b.order_id\n    LEFT JOIN campaigns c ON c.campaign_id=a.campaign_id\n), campaign_totals AS (\n    SELECT group_value, SUM(refund_cents*attribution_weight) AS numerator_cents\n    FROM attributed_refunds GROUP BY group_value\n)\nSELECT group_value, numerator_cents, SUM(numerator_cents) OVER () AS denominator_cents,\n       1.0*numerator_cents/NULLIF(SUM(numerator_cents) OVER (),0) AS value\nFROM campaign_totals ORDER BY group_value LIMIT 100", "parameters": ["2026-01-01T00:00:00Z", "2027-01-01T00:00:00Z", "华东地区"], "rows": [], "visualization": null, "verification": {"passed": true, "method": "independent_empty_group_set", "checks": {"empty_results_match": true}}, "limitations": ["只回答语义目录支持的单指标和维度。", "当前数据为可复现的合成样本。"], "elapsed_ms": 1752.74, "model_usage": {"prompt_tokens": 517, "completion_tokens": 236, "total_tokens": 753}, "model_latency_ms": 1611.017, "trajectory": [{"stage": "preflight", "outcome": "passed"}, {"stage": "planning", "outcome": "passed"}, {"stage": "compilation", "outcome": "passed"}, {"stage": "query", "outcome": "passed"}, {"stage": "verification", "outcome": "passed"}, {"stage": "answer", "outcome": "passed"}]}}
