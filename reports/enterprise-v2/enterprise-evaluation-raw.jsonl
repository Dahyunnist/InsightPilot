ON c.campaign_id=a.campaign_id\n), campaign_totals AS (\n    SELECT group_value, SUM(refund_cents*attribution_weight) AS numerator_cents\n    FROM attributed_refunds GROUP BY group_value\n)\nSELECT group_value, numerator_cents, SUM(numerator_cents) OVER () AS denominator_cents,\n       1.0*numerator_cents/NULLIF(SUM(numerator_cents) OVER (),0) AS value\nFROM campaign_totals ORDER BY group_value LIMIT 100", "parameters": ["2027-01-01T00:00:00Z", "2027-01-03T00:00:00Z"], "rows": [], "visualization": null, "verification": {"passed": true, "method": "independent_empty_group_set", "checks": {"empty_results_match": true}}, "limitations": ["只回答语义目录支持的单指标和维度。", "当前数据为可复现的合成样本。"], "elapsed_ms": 2312.326, "model_usage": {"prompt_tokens": 514, "completion_tokens": 335, "total_tokens": 849}, "model_latency_ms": 2258.549, "trajectory": [{"stage": "preflight", "outcome": "passed"}, {"stage": "planning", "outcome": "passed"}, {"stage": "compilation", "outcome": "passed"}, {"stage": "query", "outcome": "passed"}, {"stage": "verification", "outcome": "passed"}, {"stage": "answer", "outcome": "passed"}]}}
