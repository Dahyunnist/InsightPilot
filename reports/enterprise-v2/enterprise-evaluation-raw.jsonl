{"case_id": "B11", "status_ok": true, "metric_ok": false, "dimension_ok": false, "region_ok": true, "numeric_ok": false, "sql_verified": true, "reward": 1.5, "passed": false, "repeat_index": 3, "question": "2026-02-01 到 2026-02-07 按退款发生日（不是订单日或入库日）统计已支付订单的批准退款金额。", "result": {"run_id": "430d152d-4db4-498f-a4d3-7ab2754eddd8", "status": "answered", "metric": {"id": "approved_refund_amount", "name": "批准退款金额", "formula": "所选时间窗口内的批准退款金额之和", "time_basis": "按计划选择下单时间或退款事件时间", "refund_status": "仅 approved", "definition_version": "1.0.0", "effective_from": "2026-10-01", "grain": "订单 cohort", "definition_source": "docs/product-contract.md#指标字典与口径", "lineage": ["orders.order_id", "refunds.order_id", "refunds.amount_cents", "refunds.status"]}, "plan": {"start_date_inclusive": "2026-02-01", "end_date_exclusive": "2026-02-08", "periods": [["2026-02-01", "2026-02-08"]], "region": null, "dimension": null}, "data_version": "insightpilot-enterprise-v1", "data_fingerprint": "c2d4e473ae87a03f0c252c464b1d1fac393b7da58fbc982935708137d622aa92", "generated_at_utc": "2026-10-20T03:02:08.706905+00:00", "sql": "WITH eligible_orders AS (\n    SELECT o.order_id, o.paid_amount_cents, '全部' AS group_value\n    FROM orders o\n    WHERE o.status = 'paid' AND o.ordered_at >= ? AND o.ordered_at < ?\n), approved_refunds AS (\n    SELECT order_id, SUM(amount_cents) AS refund_cents\n    FROM refunds\n    WHERE status = 'approved'\n    GROUP BY order_id\n), base AS (\n    SELECT b.order_id, b.paid_amount_cents, b.group_value\n    FROM eligible_orders b\n)\nSELECT SUM(COALESCE(r.refund_cents, 0)) AS amount_cents\nFROM base b\nLEFT JOIN approved_refunds r ON r.order_id = b.order_id\n\n\nLIMIT 100", "parameters": ["2026-02-01T00:00:00Z", "2026-02-08T00:00:00Z"], "rows": [{"amount_cents": 1981594}], "visualization": null, "verification": {"passed": true, "method": "independent_scalar_sum", "checks": {"amount_matches": true}, "control": {"amount_cents": 1981594}}, "limitations": ["只回答语义目录支持的单指标和维度。", "当前数据为可复