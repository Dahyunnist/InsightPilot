cks": {"numerator_total_matches": true, "denominator_total_matches": true, "ratio_or_contribution_matches": true}, "control": {"numerator_cents": null, "denominator_cents": null, "value": null}}, "limitations": ["只回答语义目录支持的单指标和维度。", "当前数据为可复现的合成样本。"], "elapsed_ms": 2485.981, "model_usage": {"prompt_tokens": 334, "completion_tokens": 430, "total_tokens": 764, "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 334}, "model_latency_ms": 2451.63, "model_call_count": 1, "model_calls": [{"latency_ms": 2451.63, "usage": {"prompt_tokens": 334, "completion_tokens": 430, "total_tokens": 764, "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 334}, "response_model": "deepseek-flash", "created_at": 1792497657}], "response_model": "deepseek-flash", "trajectory": [{"stage": "preflight", "outcome": "passed"}, {"stage": "planning", "outcome": "passed"}, {"stage": "compilation", "outcome": "passed"}, {"stage": "query", "outcome": "passed"}, {"stage": "verification", "outcome": "passed"}, {"stage": "answer", "outcome": "passed"}]}}
