er_id\n    LEFT JOIN campaigns c ON c.campaign_id=a.campaign_id\n), campaign_totals AS (\n    SELECT group_value, SUM(refund_cents*attribution_weight) AS numerator_cents\n    FROM attributed_refunds GROUP BY group_value\n)\nSELECT group_value, numerator_cents, SUM(numerator_cents) OVER () AS denominator_cents,\n       1.0*numerator_cents/NULLIF(SUM(numerator_cents) OVER (),0) AS value\nFROM campaign_totals ORDER BY group_value LIMIT 100", "parameters": ["2026-10-01T00:00:00Z", "2026-11-01T00:00:00Z"], "rows": [{"group_value": "Campaign 01", "numerator_cents": 440872.5, "denominator_cents": 9710824.0, "value": 0.04540011228707265}, {"group_value": "Campaign 02", "numerator_cents": 205938.8, "denominator_cents": 9710824.0, "value": 0.02120713957950427}, {"group_value": "Campaign 03", "numerator_cents": 376113.5, "denominator_cents": 9710824.0, "value": 0.03873136821344924}, {"group_value": "Campaign 04", "numerator_cents": 727963.15, "denominator_cents": 9710824.0, "value": 0.0749640967646}, {"group_value": "Campaign 05", "numerator_cents": 411510.15, "denominator_cents": 9710824.0, "value": 0.042376439939597305}, {"group_value": "Campaign 06", "numerator_cents": 400590.8, "denominator_cents": 9710824.0, "value": 0.04125198850272644}, {"group_value": "Campaign 07", "numerator_cents": 441752.3, "denominator_cents": 9710824.0, "value": 0.04549071221968393}, {"group_value": "Campaign 08", "numerator_cents": 544395.1, "denominator_cents": 9710824.0, "value": 0.056060649436134355}, {"group_value": "Campaign 09", "numerator_cents": 709348.15, "denominator_cents": 9710824.0, "value": 0.07304716365985009}, {"group_value": "Campaign 10", "numerator_cents": 658189.0, "denominator_cents": 9710824.0, "value": 0.06777890321150913}, {"group_value": "Campaign 11", "numerator_cents": 441349.85, "denominator_cents": 9710824.0, "value": 0.04544926877471984}, {"group_value": "Campaign 12", "numerator_cents": 607540.1, "denominator_cents": 9710824.0, "value": 0.06256318722283505}, {"grou