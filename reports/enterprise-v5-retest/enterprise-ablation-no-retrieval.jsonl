{"case_id": "X12", "status_ok": true, "metric_ok": true, "dimension_ok": true, "region_ok": true, "numeric_ok": true, "sql_verified": true, "date_window_ok": true, "reward": 3.5, "passed": true, "result": {"run_id": "7b97832b-a66e-42bf-ad0b-cdfd6f19aedc", "status": "answered", "metric": {"id": "approved_refund_amount_rate", "name": "批准退款金额率", "formula": "批准退款金额 / 对应订单实付金额", "time_basis": "下单时间（UTC）", "refund_status": "仅 approved", "definition_version": "1.0.0", "effective_from": "2026-10-01", "grain": "订单 cohort", "definition_source": "docs/product-contract.md#指标字典与口径", "lineage": ["orders.order_id", "refunds.order_id", "refunds.amount_cents", "refunds.status"]}, "plan": {"start_date_inclusive": "2028-01-01", "end_date_exclusive": "2028-01-08", "periods": [["2028-01-01", "2028-01-08"]], "region": null, "dimension": null}, "data_version": "insightpilot-enterprise-v1", "data_fingerprint": "c2d4e473ae87a03f0c252c464b1d1fac393b7da58fbc982935708137d622aa92", "generated_at_utc": "2026-10-20T10:55:04.390294+00:00", "sql": "WITH eligible_orders AS (\n    SELECT o.order_id, o.paid_amount_cents, '全部' AS group_value\n    FROM orders o\n    WHERE o.status = 'paid' AND o.ordered_at >= ? AND o.ordered_at < ?\n), approved_refunds AS (\n    SELECT order_id, SUM(amount_cents) AS refund_cents\n    FROM refunds\n    WHERE status = 'approved'\n    GROUP BY order_id\n), base AS (\n    SELECT b.order_id, b.paid_amount_cents, b.group_value\n    FROM eligible_orders b\n)\nSELECT SUM(COALESCE(r.refund_cents, 0)) AS numerator_cents, SUM(b.paid_amount_cents) AS denominator_cents, 1.0 * SUM(COALESCE(r.refund_cents, 0)) / NULLIF(SUM(b.paid_amount_cents), 0) AS value\nFROM base b\nLEFT JOIN approved_refunds r ON r.order_id = b.order_id\n\n\nLIMIT 100", "parameters": ["2028-01-01T00:00:00Z", "2028-01-08T00:00:00Z"], "rows": [{"numerator_cents": null, "denominator_cents": null, "value": null}], "visualization": null, "verification": {"passed": true, "method": "independent_scalar_aggregation", "checks": {"numerator_total_matches": true, "denominator_total_matches": true, "ratio_or_contribution_matches": true}, "control": {"numerator_cents": null, "denominator_cents": null, "value": null}}, "limitations": ["只回答语义目录支持的单指标和维度。", "当前数据为可复现的合成样本。"], "elapsed_ms": 2642.864, "model_usage": {"prompt_tokens": 334, "completion_tokens": 435, "total_tokens": 769, "prompt_cache_hit_tokens": 128, "prompt_cache_miss_tokens": 206}, "model_latency_ms": 2604.094, "model_call_count": 1, "model_calls": [{"latency_ms": 2604.094, "usage": {"prompt_tokens": 334, "completion_tokens": 435, "total_tokens": 769, "prompt_cache_hit_tokens": 128, "prompt_cache_miss_tokens": 206}, "response_model": "deepseek-flash", "created_at": 1792493702}], "response_model": "deepseek-flash", "trajectory": [{"stage": "preflight", "outcome": "passed"}, {"stage": "planning", "outcome": "passed"}, {"stage": "compilation", "outcome": "passed"}, {"stage": "query", "outcome": "passed"}, {"stage": "verification", "outcome": "passed"}, {"stage": "answer", "outcome": "passed"}]}}
